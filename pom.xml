<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.reactor</groupId>
        <artifactId>rust-java-platform-parent</artifactId>
        <version>4.4.0</version>
        <relativePath/>
    </parent>

    <groupId>com.reactor.sample</groupId>
    <artifactId>rest-sample-cache-reader</artifactId>
    <version>0.6.2</version>
    <packaging>jar</packaging>

    <name>rest-sample-cache-reader</name>
    <description>Minimal Rust-Java REST sample that serves precomputed nested JSON from Redis through Rust JNI.</description>

    <properties>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.reactor</groupId>
            <artifactId>rust-java-starter-cache-reader</artifactId>
        </dependency>
        <dependency>
            <groupId>com.reactor.sample</groupId>
            <artifactId>rust-sample-model</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>github-rust-java-rest</id>
            <url>https://maven.pkg.github.com/esasmer-dou/rust-java-rest</url>
        </repository>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/esasmer-dou/java-rust-cache</url>
        </repository>
        <repository>
            <id>github-rust-sample-model</id>
            <url>https://maven.pkg.github.com/esasmer-dou/rust-sample-model</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>com.reactor.sample.cache.reader.app.RestSampleCacheReaderApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
